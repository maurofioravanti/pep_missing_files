  $PRINTOUT CONTROLS
 ICT(47)=-1  $NO PRINTOUT OF SCALED OR UNSCALED NORMAL EQUATIONS
 ICT(48)=-1  $NO PRINT OF COVARIANCE MATRIX
 ICT(49)=-1  $DO NOT CLEANUP INVERSE
 EXTPRC=-1   $USE DOUBLE PRECISION FOR MATRIX INVERSION
 NOPRNT=0    $PRINTOUT INPUT LINK
 ICT(1)=1     $# OF ITERATIONS
 ICT(2)=0     $PRINTOUT O-C
 ICT(3)=1,
 ICT(4)=1     $RECALCULATE ALL PARTIALS
 ICT(4)=0     $USE SAVED PARTIALS
 ICT(8)=1,   $SERIES SEQUENCING NOT CHECKED IN COMPAR
 ICT(12) = -2  $NO HARMONIC ANALYSIS OF RESIDUALS
 ICT(20)=5,      $PRINTOUT 5 PARTIALS
 ICT(21)=-1        $DO NOT CALCULATE VELOCITIES IN MDELDP
 JCT(2)=11,JCAL(3)=33,  $USE ACTIVE ATM.
 ICT(24)=0,        $DON'T PRINT ZENITH ANGLES
 ICT(27)=0,NBODY=0,IBODY=0,PRMTER(81)=0.D0, $DO NOT USE CT-AT OR S.S.B.C.
 ICT(27)=-1,ICT(39)=-2,IBODY=90,NBODY=9,PRMTER(81)=1.D0 $USE S.S.B.C
 ICT(27)=-1,ICT(39)=-2,IBODY=90,NBODY=1,PRMTER(81)=1.D0 $USE S.S.B.C
 ICT(28)=1         $CALCULATE NUT-PREC AT BOTH SEND AND RECV TIME
 ICT(39)=1     $USE WHATEVER IS ON INDIVIDUAL BODY TAPES
 ICT(50)=-2  $ NO LONGITUDE PLOTS
 JCT(10)=3,     $  INCLUDE EARTH TIDES DUE TO MOON & SUN
 JCT(11)=0,     $DO NOT INCLUDE LUNAR TIDES DUE TO EARTH & SUN
 JCT(27)=1  $USE STAR COMMANDS
 JCT(28)=2,  $INCLUDE AD HOC CORRECTIONS TO UT1 ONLY
 JCT(33)=0   $USE BIH A1-UT1 AND WOBBLE VALUES FROM PEP
 JCT(33)=33  $UT1 FROM FT33, WOBBLE FROM FT34
 ICT(77)=1    $ =0,=1; NO PUNCH,PUNCH ADJUSTED VALUES
 PRMTER(99)=0.0D0,
 IBUF1=97,       $DS FOR CORRELATION PO
 IBUF2=96        $TEMP DS FOR COEFF MATRIX
 IBUF5=25        $DS FOR MULTPAR FEATURE
 LOUT=6,         $ADDITONAL PRINTOUT FOR A PRIORI COVARIANCES
 MOUT=95,        $ DIAGNOSTICS
 IPERT=90
 EPS(1)=1.E6
