INT ?RUNNUM - MOONINTC PEPRUN - ORBIT AND ROTATION FROM ?ITER SOLUTION
LAST UPDATED: 2018/1/7

 &NMLST1
 NOPRNT=1              $ SUPRESS PRINTOUT
 EXTPRC=0              $ USE HARDWARE EXTENDED PRECISION AT LINCOLN
 ICT(1)=-1             $ NO O-C, NO LEAST SQUARES ANALYSIS
 ICT(15)=-1            $ NO ANALIZ LINK
 ICT(80)=-1            $ NO INPUT OBSLIBS
 JCT(27)=1             $ USE STAR COMMANDS
 NBODY=10,IBODY=90,IPERT=?IPERT
 JOUT=0,KOUT=0,LOUT=0,MOUT=95,INTERN=99
*INCLUDE '?PATH/pepin/sscon.?ITER'
*INCLUDE '?PATH/pepin/bltint.parms'
 ?INSPRM
*OBJECT EMBARY
*INCLUDE '?PATH/pepin/embary.?ITER'

*OBJECT MOON
 K(81)=4,5             $ EARTH 4 ZONAL; MOON 5 ZONAL, 5 TESSERAL
*INCLUDE '?PATH/pepin/moon.?ITER'
 JD0=2445701,JD1=2440401,JD2=2449641 $ 6/28/69-10/15/94
 JD0=2440001,JD1=2440001,JD2=2449641
$ JD1=2445698, JD2=2445721  $FOR TEST
 JD0= ?JD0
 JD1= ?JD1     $ REMOVE IF NO JD1 SPECIFIED
 JD2= ?JD2
 KI(1)=7*1             $ INTEGRATE MOTION AND I.C. PARTIALS
 KI(8)=-8,-16,-20,     $ MOON CONS
       -1001,-1002,-1003,-1004,-1005,-1006,  $ LIBRATION ICS
       -1009,-1010,-1012,-1013,              $ LIBRATION CONS
       -1020,-1021,-1022,                    $ CORE LIBRATION ICS
       -1023,-1024,                          $ CORE CONS
       2,3,4,5,6,10,31,32,41,42,43,44,       $ S.S. PARAMETERS
       201,202,203,204,205,206,        $ VENUS CROSS PARTIALS-INDIR STUFF
       301,302,303,304,305,306,        $ EMBARY CROSS PARTIALS-INDIR STUFF
       401,402,403,404,405,406,        $ MARS CROSS PARTIALS-INDIR STUFF
       501,502,503,504,505,506,        $ JUPITER CROSS PARTIALS-INDIR STUFF
       601,602,603,604,605,606,        $ SATURN CROSS PARTIALS-INDIR STUFF
       1031,2,3,1041,3,1,3,3,1051,3,1,3,3,   $ 3RD DEG HARMONICS
$ END OF INTEGRATED PARTIALS
 K(40)=1               $ INCLUDE MASS(10) IN PARTIALS
 K=1,2,4,5,6,          $ TARGET BODIES-INDIR STUFF
 K(61)=2*1             $ INCLUDE RELFCT AND GDOT IN PARTIALS
 K(71)=4*1             $ INCLUDE BETA, GAMMA, BETA', GAMMA'
 K(84)=1,1             $ INCLUDE TIDAL FRICTION AND P.O.E. IN PARTIALS
 K(87)=-4              $ 1/16 DAY STEP SIZE
 K(88)=2               $ ADAMS-MOULTON INTEGRATION
 K(89)=10              $ PREDICTOR/CORRECTOR TERMS
 K(98)=800             $ PRINT COORDINATES AND PARTIALS EVERY 400 DAYS
 K(100)=-1             $ INTEGRATE USUAL EQUATIONS OF MOTION
 EPS(3)=1.0D-14        $ STARTING ACCURACY 1.5MM ORBIT, 1E-8 ARCSEC ROT
 KK(84)=2       $ GET INDIRECT PARTIALS FROM TAPE-INDIR STUFF
 KK(84)=0       $ APPROX INDIRECT PARTIALS - 1ST ITER ONLY

*OBJECT MOON-ROTATION
 ITAPE=21,KK(13)=3     $ NO DEFAULT FOR ROTATION UNIT NUMBERS
 KK(11)=22,23  $ OUTPUT CORE INTEGRATION, TEMP BACK-FORE BUFFER
*INCLUDE '?PATH/pepin/mrotat.?ITER'
 JD0=2445701,JD1=2440401,JD2=2449641 $ 6/28/69-10/15/94
 JD0=2440001,JD1=2440001,JD2=2449641
 JD0= ?JD0
 JD1= ?JD1     $ REMOVE IF NO JD1 SPECIFIED
 JD2= ?JD2
 KI=7*1                $ INTEGRATE MOTION AND I.C. PARTIALS
 KI(8)=-3,-4,-6,-7,  $ INTEGRATE BETA, GAMMA, K2, K2*T,
       -14,-15,-16,-17,-18, $ CORE ROTATION PARAMETERS
       2,3,4,5,6,10,31,32,41,42,43,44,
       301,302,303,304,305,306         $ EMBARY CROSS PARTIALS
       1001,1002,1003,1004,1005,1006,  $ MOON ORBIT CROSS PARTIALS
       1014,1022,1026,
       1031,2,3,1041,3,1,3,3,1051,3,1,3,3,   $ 3RD DEG HARMONICS
$ END OF INTEGRATED PARTIALS
 K(40)=1               $ INCLUDE MASS(10) IN PARTIALS
 K(61)=1               $ INCLUDE RELFCT
 K(62)=1               $ GMVARY
 K(71)=4*1             $ INCLUDE BETA, GAMMA, BETA', GAMMA'
 K(81)=1               $ SUN INCLUDED IN MOTION AND PARTIALS
 K(82)=0               $ F-F INTERACTION IN EOM
 K(83)=0               $ ELAS. & DISS. IN EOM
 K(86)=404             $ USE 4TH ORDER ZONAL/TESSERAL HARM IN PARTIALS
 K(87)=-4              $ 1/16 DAY STEP SIZE
 K(88)=2               $ ADAMS-MOULTON INTEGRATION
 K(89)=10              $ PREDICTOR/CORRECTOR TERMS
 K(91)=-7              $ STARTING INTERVAL = 1/128 DAY
 K(92)=-8              $ MINIMUM INTERVAL = 1/256 DAY
 K(98)=800             $ PRINT COORDINATES AND PARTIALS EVERY 400 DAYS
 K(100)=-1             $ EULER ANGLE INTEGRATION
 INT=-1                $ HALF DAY TABULAR INTERVAL

*OBJECT
*INCLUDE '?PATH/pepin/mercury.?ITER'
 CON(2)=0          $ NO FLATTENING, NO SHAPE NEEDED

*OBJECT
*INCLUDE '?PATH/pepin/venus.?ITER'
 CON(2)=0          $ NO FLATTENING, NO SHAPE NEEDED

*OBJECT
*INCLUDE '?PATH/pepin/mars.?ITER'
 CON(2)=0          $ NO FLATTENING, NO SHAPE NEEDED

*OBJECT
*INCLUDE '?PATH/pepin/jupiter.?ITER'
 CON(2)=0          $ NO FLATTENING, NO SHAPE NEEDED

*OBJECT
*INCLUDE '?PATH/pepin/saturn.?ITER'
 CON(2)=0          $ NO FLATTENING, NO SHAPE NEEDED

*OBJECT
*INCLUDE '?PATH/pepin/uranus.?ITER'
 CON(2)=0          $ NO FLATTENING, NO SHAPE NEEDED

*OBJECT
*INCLUDE '?PATH/pepin/neptune.?ITER'
 CON(2)=0          $ NO FLATTENING, NO SHAPE NEEDED
**END
