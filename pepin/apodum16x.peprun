OBS ?RUNNUM - O-C DUMMY LLR DATA FROM APACHE POINT - ALL PARTIALS
$ITR78 EPHEMERIS WITH NEW GR
$DTS DEFINED FOR SOLUTION WITH NEW LLR DATA
 &NMLST1
*INCLUDE '?PATH/pepin/llrnlst1.include'
 ICT(4)=?PCOP      $ REDO PARTIALS (1) OR QUICK COPY PARTIALS (-3)
 ICT(15)=-1            $ NO ANALIZ
 ICT(23)=?VAR1         $ ATMOSPHERE MODEL
 JCT(10)=3,3           $ SOLID-BODY TIDES ON EARTH AND MOON
 ICT(29)=1             $ USE DERIVATIVES OF PREC/NUT
 JCT(29)=1, ICT(34)=0  $ EROTAT CONS ARE NUTATION TERMS
 ICT(44)= 0            $ NO A PRIORI
$ JCT(71)=4, ICTAT=36   $ USE CT-AT INTEGRATION
 IOBS=0,ICT(80)=0,
 ICT(3)=1      $ DUMMY DATA
 EPS(17)=0.5   $ ALLOW ONLY ABOVE 30 DEG ELEVATION
 NUMOBT=1
 IOBS1=60,61,62,63,64,65,66,67,68,69
*INCLUDE '?PATH/pepin/sscon.?ITER'
 LPRM=2,3,5,10,31,32,41,42,43,44,51,52,72  $ADJUST ALL PARAMETERS
*INCLUDE '?PATH/pepin/dtc06.include'
*OBJECT EMBARY
*INCLUDE '?PATH/pepin/embary.?ITER'
 L=1,1,1,1,1,1,       $ADJUST EMBARY INITIAL CONDITONS
   3,4,5              $ TIDE PARAMETERS
*OBJECT EARTH-ROTATION
*INCLUDE '?PATH/pepin/erotat.?ITER'
 CON(1)=6*0           $ZERO ALL AD HOC ROTATION ANGLES AND RATES
 CON1(2)=433.5        $PERIOD FOR FREE-CORE NUTATION
  L(7)=1,2,           $FREE CORE NUTATION
       3,4,5,6,7,8,9,10, $ IN-PHASE NUTATION TERMS
       11,12,13,14,15,16,17,18,  $ OUT-OF -PHASE NUTATION TERMS
       19,20,         $ K/C FORTNIGHTLY AND K/C MONTHLY
       22,23,24       $ PREC., OBLQ., NUT'N CONSTANTS
*OBJECT MOON
*INCLUDE '?PATH/pepin/moon.?ITER'
 LJ2=1,LJ3=1
 LC2=2*0,LC3=3*1
 LS2=2*0,LS3=3*1
 L=6*1,8,16,20,24  $ADJUST ICS, AD HOC PREC, NDOT, POE, CON24
 
*OBJECT MOON-ROTATION
*INCLUDE '?PATH/pepin/mrotat.?ITER'
 ITAPE=21  $NEEDED TO HAVE ILIB TAPE USED
 L=6*1,3,4,6,7,    $ADJUST I.C.S PLUS BETA, GAMMA, K2, K2T
   14,15,16,17,18  $ AND CORE ROTATION PARAMETERS
 
