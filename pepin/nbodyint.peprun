INT ?RUNNUM - NBODYINT - ?ITER INTEG. ?JD2 (IPERT= ?IPERT)
 &NMLST1
  NOPRNT=1              $ NO INPUT PRINT
  ICT(1)=-1             $ NO O-C, NO LEAST SQUARES ANALYSIS
  ICT(50)= 1            $ USE BROWN MEAN MOON IF NO IPERT
  ICT(80)=-1            $ NO INPUT OBSLIBS
  NPLBDY=1,2,3,4,5,6,7,8,9      $ INTEGRATE MERCURY TO PLUTO
  NBODY=9,IBODY=10,MOUT=95
  IPERT= ?IPERT         $ PERTURB. BODY TAPE, IF ANY
  JDBDY0=2440001,JDBDY1=2433283,JDBDY2=2488071   $ 1950/1/1 TO 2100/1/1
  JDBDY0=?JD0
  JDBDY1=?JD1         $ REMOVE IF NO JD1 SPECIFIED
  JDBDY2=?JD2
  KBDY(27)=-1           $ STEP SIZE FOR PLANETS ONLY
  KBDY(28)=2            $ ADAMS-MOULTON
  KBDY(36)=-1           $ OLD G.R.
  KBDY(21)=3*0          $ INCLUDE RELFCT, GMVARY, SUNHAR
$ KBDY(36)=0            $ USE FULL G.R. FORMULATION
  KKBDY(80)=1           $ INCLUDE ASTEROID RING PERTURBATION
$ KBDY(39)=-1           $ NO OUTPUT TAPE
  KBDY(38)=200          $ PRINT EVERY 200TH TABULAR POINT
*INCLUDE '?PATH/pepin/sscon.?ITER'
 ?INSPRM
*OBJECT
*INCLUDE '?PATH/pepin/mercury.?ITER'

*OBJECT
*INCLUDE '?PATH/pepin/venus.?ITER'
 
*OBJECT
*INCLUDE '?PATH/pepin/moon.?ITER'
 
*OBJECT
*INCLUDE '?PATH/pepin/embary.?ITER'
 
*OBJECT
*INCLUDE '?PATH/pepin/mars.?ITER'
 
*OBJECT
*INCLUDE '?PATH/pepin/jupiter.?ITER'
 
*OBJECT
*INCLUDE '?PATH/pepin/saturn.?ITER'
 
*OBJECT
*INCLUDE '?PATH/pepin/uranus.?ITER'
 
*OBJECT
*INCLUDE '?PATH/pepin/neptune.?ITER'
 
*OBJECT
*INCLUDE '?PATH/pepin/pluto.nbody311'
 
**END
