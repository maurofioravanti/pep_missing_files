 CON(1)=6*0           $ZERO ALL AD HOC ROTATION ANGLES AND RATES
 CON1(2)=433.5        $PERIOD FOR FREE-CORE NUTATION
  L(7)=1,2,           $FREE CORE NUTATION
       3,4,5,6,7,8,9,10, $ IN-PHASE NUTATION TERMS
