 &NMLST1
 NOPRNT=1
 EPS=4*1.E6
 EPS(9)=70.,5.     $ PARTIAL/FULL CONVERGENCE CRITERION FACTOR
 EXTPRC=-1         $ USE DOUBLE PRECISION
 ICT(1)=1          $ 1 ITERATION
 ICT(10)=-2,ICT(11)=-2       $ NO PREDICT
 ICT(12)=-2        $ NO HARMONIC ANALYSIS
 ICT(15)=0         $ NORMAL ANALIZ
 ICT(20)=-5        $ PRINT SOME PARTIALS EACH SERIES
 ICT(21)=-1        $ USE PHASE DELAY FOR DOPPLER
 ICT(25)=18        $ DEMOD LIMIT = 2**(-18) = 3.81 MICROSECONDS
 ICT(27)=-1        $ S.S. CENTER OF MASS CORRECTION IN O-C ONLY FOR LLR
 ICT(3)=1          $ WRITE DUMMY OBS AND PARTIALS ON TAPE
 ICT(39)=-2        $ TAKE NOTHING FROM N-BODY TAPE EXCEPT S.S. C.M.
 ICT(40)=1         $ ANY EMBARY INTEGRATION USES SBFN
 ICT(43)=1         $ USE RAD ROUTINES
 ICT(44)=1         $ APRIORI IN INPUT RUNSTREAM
 ICT(46)=0         $ USE DOUBLE PRECISION TO INVERT MATRIX
 ICT(47)=-1        $ NO PRINT OF N.E.
 ICT(48)=-1        $ PRINT CORRELATION BUT NOT COVARIANCE
 ICT(49)=-1        $ NO ITERATIVE CLEANUP
 ICT(66)=1         $ NEW ROTATION MODEL (NEED FOR PERIOD ADJUST)
 ICT(76)=14        $ FLAG ALL SNE DISPARITIES, CORRECT RHS
 JCT(14)=1         $ USE CROSS PARTIALS
 JCT(20)=2         $ STOP ON MULTPAR ERRORS
 JCT(27)=1         $ USE STAR COMMANDS
 JCT(67)=1         $ MAKE LIGHT TIME ITERATION CORRECTION TO PARTIALS
 IBUF5=25,IBUF6=26 $ FOR MULTPAR INPUT
 IBUF7=27,IBUF8=28,IBUF9=29     $ FOR PARTIAL PREREDUCTION
 IBUF1=97          $ PARAMETER NAMES
 IBUF2=96          $ FOR A PRIORI
 IMAT=94           $ SAVE SOLUTION
 NBODY=10,IBODY=90,IPERT=90,JOUT=0,KOUT=0,LOUT=6,MOUT=95,INTERN=99
